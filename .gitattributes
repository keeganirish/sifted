# Shell scripts must keep Unix line endings even when Windows users clone with
# core.autocrlf=true, or bash inside WSL fails with "$'\r': command not found".
*.sh        text eol=lf
/sifted     text eol=lf
*.py        text eol=lf
# Windows scripts keep Windows line endings.
*.cmd       text eol=crlf
*.ps1       text eol=crlf
# Binary assets
*.png       binary
*.ico       binary
*.siftlog   binary
# Test fixtures and fuzz corpora are compared byte for byte.
tests/fixtures/**  -text
fuzz/corpus*/**    -text
