#!/usr/bin/env bash
# Starts Sifted: the fusion service, the simulators and the operator view in
# your browser. Run ./install.sh once first. Options: ./sifted --help
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
for p in python3 python3.13 python3.12 python3.11 python3.10 python; do
  if command -v "$p" >/dev/null 2>&1 && "$p" -c 'import sys; sys.exit(sys.version_info < (3, 10))' 2>/dev/null; then
    exec "$p" "$ROOT/app/launcher.py" "$@"
  fi
done
echo "sifted: Python 3.10 or newer is required. Run ./install.sh to set everything up." >&2
exit 1
